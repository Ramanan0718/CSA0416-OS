
#include <stdio.h>
#include <string.h>

int main() {
    char users[10][20], files[10][10][20];
    char user[20], file[20];
    int count[10] = {0};
    int nu = 0, choice, i, j, u, found;

    while (1) {
        printf("\n1.Create User\n2.Create File\n3.Display\n4.Exit\n");
        printf("Enter choice: ");
        scanf("%d", &choice);

        if (choice == 1) {
            if (nu == 10) {
                printf("Maximum users reached\n");
                continue;
            }

            printf("Enter username: ");
            scanf("%19s", user);

            found = 0;
            for (i = 0; i < nu; i++)
                if (strcmp(users[i], user) == 0)
                    found = 1;

            if (found)
                printf("User already exists\n");
            else {
                strcpy(users[nu++], user);
                printf("User created\n");
            }
        }
        else if (choice == 2) {
            printf("Enter username: ");
            scanf("%19s", user);
            u = -1;

            for (i = 0; i < nu; i++)
                if (strcmp(users[i], user) == 0)
                    u = i;

            if (u == -1) {
                printf("User not found\n");
                continue;
            }

            if (count[u] == 10) {
                printf("Directory full\n");
                continue;
            }

            printf("Enter filename: ");
            scanf("%19s", file);

            found = 0;
            for (j = 0; j < count[u]; j++)
                if (strcmp(files[u][j], file) == 0)
                    found = 1;

            if (found)
                printf("File already exists\n");
            else {
                strcpy(files[u][count[u]++], file);
                printf("File created\n");
            }
        }
        else if (choice == 3) {
            for (i = 0; i < nu; i++) {
                printf("\nUser: %s\n", users[i]);
                for (j = 0; j < count[i]; j++)
                    printf("%s\n", files[i][j]);
            }
        }
        else if (choice == 4)
            break;
        else
            printf("Invalid choice\n");
    }

    return 0;
}


#include <stdio.h>
#include <sys/ipc.h>
#include <sys/msg.h>
#include <sys/wait.h>
#include <unistd.h>
#include <string.h>

struct message {
    long type;
    char text[100];
};

int main() {
    int id;
    struct message m;
    pid_t pid;

    id = msgget(IPC_PRIVATE, 0666 | IPC_CREAT);

    pid = fork();

    if(pid == 0) {
        msgrcv(id, &m, sizeof(m.text), 1, 0);
        printf("Child received: %s\n", m.text);
    } else {
        m.type = 1;
        strcpy(m.text, "Hello from parent process");

        msgsnd(id, &m, sizeof(m.text), 0);
        printf("Parent sent message\n");

        wait(NULL);
        msgctl(id, IPC_RMID, NULL);
    }

    return 0;
}

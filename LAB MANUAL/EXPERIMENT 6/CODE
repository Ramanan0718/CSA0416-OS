
#include <stdio.h>

int main() {
    int n, i, time = 0, done = 0, smallest;
    int at[20], bt[20], rt[20], p[20], ct[20], wt[20], tat[20];

    printf("Enter number of processes: ");
    scanf("%d", &n);

    for(i = 0; i < n; i++) {
        printf("Enter arrival time, burst time and priority: ");
        scanf("%d%d%d", &at[i], &bt[i], &p[i]);
        rt[i] = bt[i];
    }

    while(done < n) {
        smallest = -1;

        for(i = 0; i < n; i++) {
            if(at[i] <= time && rt[i] > 0) {
                if(smallest == -1 || p[i] < p[smallest])
                    smallest = i;
            }
        }

        if(smallest == -1) {
            time++;
            continue;
        }

        rt[smallest]--;
        time++;

        if(rt[smallest] == 0) {
            ct[smallest] = time;
            done++;
        }
    }

    printf("\nProcess\tBT\tPriority\tWT\tTAT\n");

    for(i = 0; i < n; i++) {
        tat[i] = ct[i] - at[i];
        wt[i] = tat[i] - bt[i];

        printf("P%d\t%d\t%d\t\t%d\t%d\n",
               i+1, bt[i], p[i], wt[i], tat[i]);
    }

    return 0;
}
